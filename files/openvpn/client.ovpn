client
dev tun
proto tcp
remote 94.184.43.106 1194
nobind
remote-cert-tls server
auth-user-pass
cipher AES-128-CBC
auth SHA1

# ==========================================================
# بدون نیاز به خاموش کردن وی‌پی‌ان دسترسی مستقیم به پنل کاربری IBSng
# ==========================================================
route 94.184.45.58 255.255.255.255 net_gateway

# ==========================================================
# پایداری مداوم و ضد قطعی (استاندارد و بدون خطای آیفون)
# ==========================================================
ping 5
ping-restart 30

